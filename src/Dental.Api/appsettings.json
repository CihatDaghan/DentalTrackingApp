{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "DentalTrackingApp",
    "Audience": "DentalTrackingApp",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Turnstile": {
    "SecretKey": ""
  },
  "Storage": {
    "LocalRoot": "./data/files",
    "MaxUploadBytes": 26214400
  },
  "Public": {
    "BaseUrl": "http://localhost:4200",
    "ApiBaseUrl": "http://localhost:5210"
  },
  "Security": {
    "TcknHmacKey": ""
  },
  "Integrations": {
    "DefaultEInvoiceProvider": "fake",
    "DefaultSmsProvider": "fake",
    "DefaultWhatsAppProvider": "fake",
    "DefaultPaymentProvider": "fake",
    "DefaultEnabizProvider": "fake",
    "ProviderOverride": {
      "EInvoice": "",
      "Sms": "",
      "WhatsApp": "",
      "Payment": "",
      "Enabiz": ""
    },
    "EInvoice": {
      "Uyumsoft": {
        "TestUrl": "https://efatura-test.uyumsoft.com.tr/services/Integration",
        "LiveUrl": "https://efatura.uyumsoft.com.tr/services/Integration"
      },
      "Nes": {
        "TestUrl": "https://apitest.nes.com.tr",
        "LiveUrl": "https://api.nes.com.tr"
      }
    },
    "Enabiz": {
      "SysTestUrl": "https://systest.sagliknet.saglik.gov.tr/SYS/SYSWS.svc",
      "SysLiveUrl": "https://sys.sagliknet.saglik.gov.tr/SYS/SYSWS.svc",
      "SkrsUrl": "https://skrs.saglik.gov.tr/api/SkrsService",

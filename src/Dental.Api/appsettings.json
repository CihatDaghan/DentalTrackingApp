      "AppSecret": ""
    },
    "Payments": {
      "Iyzico": {
        "SandboxUrl": "https://sandbox-api.iyzipay.com",
        "LiveUrl": "https://api.iyzipay.com"
      }
    }
  },
  "AllowedHosts": "*"
